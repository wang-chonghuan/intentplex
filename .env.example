# The site reads its content from Postgres; without this it will not start.
# n-easyapp allocates it (schema intentplex-schema on pg-easyapp-shared).
DATABASE_URL=

# Sign-in. One GitHub OAuth app, one allowed account.
# ADMIN_GITHUB_USER_ID is the numeric id, not the login: a login can be renamed
# and then claimed by somebody else.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_USER_ID=
# Any long random string. Rotating it signs every session out.
SESSION_SECRET=

# Generating the English version and the four platform posts, and drawing a
# cover when one is asked for. The author's own Azure OpenAI deployments —
# gpt-5.6-sol for text, gpt-image-2 for images — the same credentials the local
# litellm proxy fronts for Codex. The proxy itself is not in the path: it
# listens on 127.0.0.1 of a laptop, and the site runs in a container.
AZURE_OPENAI_API_KEY=
